# Environment Configuration Example for Label Audit Backend
# Copy to backend/.env and populate with your keys if using optional external services.

# Optional LLM Provider for verification agent (leave blank to use deterministic rule-based reasoner)
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Genius API Client Access Token for lyrics fallback
GENIUS_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=180
